# ==============================================================================
# YT AUTOMATION STUDIO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE: SUPABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Provide your Supabase project credentials.
# If empty, the studio falls back to a local SQLite database for offline/local development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# YOUTUBE & GOOGLE OAUTH 2.0
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# OAuth 2.0 Client IDs (Web application)
# Authorized redirect URI: http://127.0.0.1:8000/api/v1/youtube/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/youtube/oauth2callback
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# AI PROVIDERS (Configure one or more)
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=gemini # Options: gemini | openai | anthropic | local

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local AI (Ollama / vLLM / LocalAI)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# LOCAL AGENT & FOLDER AUTOMATION
# ------------------------------------------------------------------------------
# Windows Root Directory for Video Ingestion & Pipeline
# Default: ./data/YT-Automation (or configure to D:\YT-Automation)
YT_AUTOMATION_ROOT=./data/YT-Automation
AGENT_AUTH_TOKEN=agent_secret_token_default_local
AGENT_POLL_INTERVAL_SECONDS=2
STABLE_FILE_TIMEOUT_SECONDS=5
MAX_UPLOAD_RETRY_COUNT=5

# Cost & Quality Presets: low_cost | balanced | high_quality
DEFAULT_AI_QUALITY_PRESET=balanced
