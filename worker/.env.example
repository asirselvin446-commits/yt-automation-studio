# Copy to worker/.env for local runs (authorize.py, push_local.py). In GitHub
# Actions, set these as repo secrets instead (never commit real values).
# WORKER_SECRET_KEY must be IDENTICAL everywhere or stored tokens won't decrypt.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=raw-videos

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Laptop-side: the custom folder on your device to fetch videos from.
LOCAL_WATCH_FOLDER=

# Any strong random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_SECRET_KEY=

# Optional: instantly trigger the GitHub upload when a video is queued.
# GITHUB_TOKEN needs a fine-grained PAT with "Contents: read/write" on the repo.
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo

# Optional upload defaults
UPLOAD_PRIVACY_STATUS=private
UPLOAD_CATEGORY_ID=22
